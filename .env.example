# Образец переменных окружения для СЕРВЕРА.
# Локально файл .env не нужен: значения по умолчанию в
# settings.py и docker-compose.yml рассчитаны на разработку.
# На сервере скопировать в .env и заполнить.

DJANGO_SECRET_KEY=сгенерировать-длинный-случайный-ключ
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=managesystems.ru
POSTGRES_HOST=db
POSTGRES_DB=selforg
POSTGRES_USER=selforg
POSTGRES_PASSWORD=сильный-пароль
CELERY_BROKER_URL=redis://redis:6379/0
TIME_ZONE=Europe/Moscow
